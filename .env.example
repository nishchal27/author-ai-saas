# =============================================================================
# Varabhi environment template
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env`. Use placeholders only — no real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Required always (app will not start / Prisma will not connect without these)
# -----------------------------------------------------------------------------

# Pooled Postgres URL used by the Prisma Client at runtime (e.g. Supabase pooler :6543).
# For Supabase/Neon poolers, include pgbouncer=true when required by your provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session/direct URL for migrations & introspection (schema.prisma `directUrl`).
# Often the same host on :5432 (session mode) or a non-pooled connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Public site URL (local or production). Used for OpenRouter HTTP-Referer when set.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Required in production (NODE_ENV=production) — see lib/env.ts
# -----------------------------------------------------------------------------

# Encrypts third-party integration tokens at rest (AES-256-GCM). Min 16 characters.
# Production always requires this to store LinkedIn/Twitter/GitHub tokens.
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Protects /api/cron/* and production /api/health/db (Authorization: Bearer <value>).
# Must be a non-empty secret. Empty values fail closed (never accept "Bearer undefined").
CRON_SECRET=replace-with-a-long-random-cron-secret

# -----------------------------------------------------------------------------
# AI providers (optional for app boot; required for AI features)
# At least one key is needed for brand summarize, idea generation, drafts, etc.
# Configure only the providers you use — do not invent unused keys.
# -----------------------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENROUTER_API_KEY=sk-or-xxxxxxxx

# Optional OpenRouter attribution title (defaults to "Varabhi")
# OPENROUTER_APP_TITLE=Varabhi

# Optional model ID overrides (see lib/ai/models.ts / lib/ai/MODELS.md)
# AI_MODEL_ANTHROPIC_STANDARD=
# AI_MODEL_ANTHROPIC_PREMIUM=
# AI_MODEL_ANTHROPIC_FAST=
# AI_MODEL_OPENAI_DEFAULT=
# AI_MODEL_OPENAI_FAST=
# AI_MODEL_OPENROUTER_DEFAULT=
# AI_MODEL_OPENROUTER_FAST=

# -----------------------------------------------------------------------------
# Inngest (required when using scheduled publishing / background jobs)
# Create an app at https://app.inngest.com — keys are verified by the SDK.
# The /api/inngest route is Clerk-public; Inngest signature verification still applies.
# -----------------------------------------------------------------------------

# INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxx
# INNGEST_EVENT_KEY=xxxxxxxx

# -----------------------------------------------------------------------------
# Development-only / tooling (never enable plaintext tokens in production)
# -----------------------------------------------------------------------------

# Allow storing integration tokens without ENCRYPTION_KEY in non-production only.
# ALLOW_PLAINTEXT_TOKENS=1

# Seed script (npm run populate) — your Clerk user id
# POPULATE_CLERK_ID=user_xxxxxxxx
# NEXT_PUBLIC_SEED_CLERK_ID=user_xxxxxxxx
# POPULATE_CLEAN=1
