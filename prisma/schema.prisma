// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  name          String?
  tier          String   @default("standard") // "standard" | "premium"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Active product context
  activeProductId String?

  // Build in public: founder bio (who you are, what you share)
  founderBio String? @db.Text

  // Content: brand voice override (JSON: { tone: "..." })
  brandVoice String? @db.Text

  // Relations
  products      Product[]
  integrations  Integration[]
  activities    Activity[]
  insights      Insight[]
  contentDrafts ContentDraft[]
  schedules     Schedule[]
}

// ============================================
// PRODUCT-AWARE MARKETING INTELLIGENCE
// ============================================

// Product: The core entity that drives all marketing decisions
// One founder can have multiple products, each with its own strategy
model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  
  // Product Classification (determines strategy)
  type        String   // "saas", "course", "coaching", "physical", "event", "api", "service", "ngo"
  industry    String   // e.g., "devtools", "education", "finance", "lifestyle", "enterprise"
  audience    String   // e.g., "developers", "smb_owners", "consumers", or custom text
  audienceDetail String?  @db.Text  // Optional: "who exactly?" e.g. college students trying to lose weight
  stage       String   // "idea", "building", "launched", "growing", "mature"
  salesMotion String   // "self_serve", "demo", "creator_led", "enterprise", "impulse"
  
  // Optional context for AI
  description String?  @db.Text  // Brief product description
  website     String?            // Product website/landing page
  competitors String?  @db.Text  // Known competitors (helps AI understand positioning)
  techStackJson String? @db.Text  // JSON array of { name, version?, note? } for build in public

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy    MarketingStrategy?
  activities  Activity[]
  insights    Insight[]
  contentDrafts ContentDraft[]

  @@index([userId])
}

// MarketingStrategy: AI-generated, opinionated recommendations per product
// This is the "Strategy Decision Layer" - the heart of AuthorAI's value
model MarketingStrategy {
  id          String   @id @default(cuid())
  productId   String   @unique
  
  // Platform Recommendations (what TO do and what NOT to do)
  platforms   String   @db.Text  // JSON: { recommended: [...], avoid: [...], reasoning: {...} }
  
  // Content Style
  contentTypes String  @db.Text  // JSON: { recommended: [...], avoid: [...] }
  tone        String   @db.Text  // JSON: { style: "...", examples: [...], avoid: [...] }
  visualStyle String   @db.Text  // JSON: { style: "...", colors: "...", examples: [...] }
  
  // Execution Guidance
  cadence     String   @db.Text  // JSON: { frequency: "...", reasoning: "..." }
  proofTypes  String   @db.Text  // JSON: { types: [...], examples: [...] }
  
  // What NOT to do (very important - reduces decision fatigue)
  antiPatterns String  @db.Text  // JSON: { avoid: [...], reasoning: {...} }
  
  // Strategy explanation (human-readable)
  summary     String   @db.Text  // 2-3 sentence strategy summary
  reasoning   String   @db.Text  // Detailed explanation of why these recommendations
  
  // Confidence and status
  confidence  Float    @default(0.8)  // AI confidence in this strategy
  status      String   @default("active") // "draft", "active", "outdated"
  
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Integration {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "github", "linkedin", "twitter", etc.
  provider    String   // "github", "linkedin", etc.
  accessToken String?  @db.Text
  refreshToken String? @db.Text
  config      String?  @db.Text // JSON config
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  productId   String?  // Links activity to specific product
  type        String   // "github_commit", "github_pr", "feedback", "manual"
  source      String   // "github", "manual", "upload"
  title       String
  description String?  @db.Text
  metadata    String?  @db.Text // JSON: commit hash, PR number, etc.
  rawData     String?  @db.Text // Full raw data
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  insights Insight[]

  @@index([userId, processed])
  @@index([productId])
  @@index([createdAt])
}

model Insight {
  id          String   @id @default(cuid())
  userId      String
  productId   String?  // Links insight to specific product
  activityId  String?
  coreProblem String   @db.Text
  solution    String   @db.Text
  audience    String   @db.Text
  whyMatters  String   @db.Text
  impact      String?  @db.Text
  themes      String?  @db.Text // JSON array
  status      String   @default("draft") // "draft", "approved", "rejected"
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  activity     Activity?     @relation(fields: [activityId], references: [id], onDelete: SetNull)
  contentDrafts ContentDraft[]

  @@index([userId, status])
  @@index([productId])
}

model ContentDraft {
  id          String   @id @default(cuid())
  userId      String
  productId   String?  // Links content to specific product (inherits strategy)
  insightId   String
  type        String   // "post", "blog", "carousel", "thread", "caption"
  platform    String?  // "linkedin", "twitter", "blog", "facebook", etc.
  title       String?
  content     String   @db.Text
  visualPrompt String? @db.Text
  visualUrl   String?
  cta         String?
  status      String   @default("draft") // "draft", "approved", "scheduled", "published", "rejected"
  edits       String?  @db.Text // JSON: edit history
  version     Int      @default(1)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Intent, reason, and context (why / for whom this content)
  intent           String?  // Content intent taxonomy: engineering_credibility, build_in_public, etc.
  generationReason String?  @db.Text // Why we're creating this content
  audienceContext  String?  @db.Text // Optional context for audience
  whyThisContent   String?  @db.Text // AI-generated one-liner: why we suggest this content

  // Content Intelligence: audience segment and persona (who / how)
  audienceSegment String?  // "non_technical" | "technical"
  persona         String?  // "founder_engineer" | "product_company"

  // Engine suggestions (format/platform from decision pipeline; user can override via type/platform)
  suggestedFormat   String?  // e.g. post, blog, carousel
  suggestedPlatform String?  // platform recommended by engine

  // Evaluation layer (post-generation quality check)
  evaluationScore Float?   // 0-1 score
  evaluationNote  String? @db.Text  // One sentence: why this fits platform/goal

  // Repurposing lineage (optional)
  sourceDraftId String?  // When this draft was created by repurposing another
  sourceDraft   ContentDraft?  @relation("RepurposeLineage", fields: [sourceDraftId], references: [id], onDelete: SetNull)
  repurposedDrafts ContentDraft[] @relation("RepurposeLineage")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@index([userId, status])
  @@index([productId])
  @@index([insightId])
}

model Schedule {
  id            String   @id @default(cuid())
  userId        String
  contentDraftId String
  platform      String
  scheduledAt   DateTime
  publishedAt   DateTime?
  status        String   @default("pending") // "pending", "published", "failed"
  errorMessage  String?  @db.Text
  externalId    String?  // Platform-specific post ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentDraft ContentDraft @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  analytics    Analytics[]

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([externalId])
}

model Analytics {
  id          String   @id @default(cuid())
  scheduleId  String
  platform    String
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  clicks      Int      @default(0)
  impressions Int     @default(0)
  engagement  Float    @default(0) // Calculated engagement rate
  metadata    String?  @db.Text // JSON: additional platform-specific metrics
  recordedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([recordedAt])
}
